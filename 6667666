-- ==========================================
-- 5. ENGINE LOOP (ลูปการทำงานหลัก)
-- ==========================================
floatFireNitro.MouseButton1Down:Connect(function() isFloatPressing = true end)
floatFireNitro.MouseButton1Up:Connect(function() isFloatPressing = false end)

RunService.RenderStepped:Connect(function()
	-- ระบบดันความเร็วรถ (Vehicle Physics)
	if isNitroActive or isFloatPressing then
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
				local seat = hum.SeatPart
				if seat.ThrottleFloat > 0 or seat.Throttle > 0 or isFloatPressing then
					local moveVec = seat.CFrame.LookVector * (speedVal * 1.55)
					seat.AssemblyLinearVelocity = Vector3.new(moveVec.X, seat.AssemblyLinearVelocity.Y, moveVec.Z)
				end
			end
		end
	end

	-- ระบบกันตาย (GodMode)
	if isGodmode then
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health < hum.MaxHealth then
				hum.Health = hum.MaxHealth
			end
		end
	end
end)
